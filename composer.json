{
    "name": "gallu/slim-littie-tools",
    "description": "little tools for Slim Framework skeleton applications",
    "keywords": ["microframework", "rest", "psr7", "slim"],
    "license": "MIT",
    "authors": [
        {
            "name": "Michiaki Furusho"
        }
    ],
    "require": {
        "php": "^8.1",
        "slim/csrf": "^1.0.0",
        "slim/slim": "^4.12.0",
        "slim/psr7": "^1.6.1",
        "php-di/php-di": "^7.0.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.19",
        "friendsofphp/php-cs-fixer": "^3.64.0",
        "nyholm/psr7": "^1.8.1",
        "nyholm/psr7-server": "^1.0.2"
    },
    "autoload": {
        "psr-4": {
            "SlimLittleTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SlimLittleTools\\Tests\\": "tests/"
        }
    }
}
